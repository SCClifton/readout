 "derive": {
  "stageCalc": {
   "from": "stages",
   "where": {
    "line": "$view"
   },
   "add": {
    "target": ["mul","throughput","targetCt"],
    "excess": [
     "pos",
     ["sub","wip","target"]
    ],
    "excessValue": ["mul","excess","unitCost"],
    "wipValue": ["mul","wip","unitCost"],
    "lower": ["mul","target",0.9],
    "upper": ["mul","target",1.1]
   }
  },
  "byStage": {
   "from": "stageCalc",
   "group": "stage",
   "agg": {
    "wip": ["sum","wip"],
    "target": ["sum","target"],
    "lower": ["sum","lower"],
    "upper": ["sum","upper"],
    "excess": ["sum","excess"],
    "excessValue": ["sum","excessValue"],
    "wipValue": ["sum","wipValue"]
   }
  },
  "byStageLoad": {
   "from": "byStage",
   "add": {
    "load": ["div","wip","target"]
   }
  },
  "output": {
   "from": "stages",
   "where": {
    "line": "$view",
    "stage": "Pack"
   }
  },
  "trendView": {
   "from": "trend",
   "where": {
    "line": "$view"
   },
   "group": "week",
   "agg": {
    "wip": ["sum","wip"],
    "target": ["sum","target"],
    "lower": ["sum","lower"],
    "upper": ["sum","upper"],
    "excess": ["sum","excess"]
   }
  },
  "orderCalc": {
   "from": "orders",
   "where": {
    "line": "$view"
   },
   "add": {
    "ageRatio": ["div","ageDays","targetCt"],
    "value": ["mul","qty","unitCost"],
    "excessQty": ["mul","qty","excessRate"],
    "agedUnits": [
     "mul",
     "qty",
     [
      "gte",
      ["div","ageDays","targetCt"],
      2
     ]
    ],
    "lateUnits": [
     "mul",
     "qty",
     [
      "gte",
      ["div","ageDays","targetCt"],
      1
     ]
    ]
   }
  },
  "ageBins": {
   "from": "orderCalc",
   "bin": "ageRatio",
   "step": 0.5,
   "agg": {
    "units": ["sum","qty"]
   }
  },
  "byFamily": {
   "from": "orderCalc",
   "group": "family",
   "agg": {
    "excess": ["sum","excessQty"]
   },
   "sort": "-excess",
   "top": 6
  }
 },
 "facts": {
  "lateShare": {
   "value": [
    "div",
    ["sum","orderCalc.lateUnits"],
    ["sum","orderCalc.qty"]
   ],
   "format": "pct0"
  }
 },
 "kpis": {
  "excess": {
   "label": "Excess WIP",
   "value": ["sum","byStage.excess"],
   "format": "int",
   "unit": "units",
   "hero": true,
   "detail": {
    "value": [
     "div",
     ["sum","byStage.excess"],
     ["sum","byStage.wip"]
    ],
    "format": "pct0",
    "text": "of all WIP"
   },
   "delta": {
    "from": ["prev","trendView.excess"],
    "label": "vs last week",
    "good": "down"
   },
   "spark": {
    "data": "trendView",
    "y": "excess"
   }
  },
  "excessValue": {
   "label": "Value of excess WIP",
   "value": ["sum","byStage.excessValue"],
   "format": "cur0",
   "detail": {
    "value": ["sum","byStage.wipValue"],
    "format": "curCompact",
    "text": "total WIP value"
   }
  },
  "cycle": {
   "label": "Implied cycle time",
   "value": [
    "div",
    ["sum","byStage.wip"],
    ["sum","output.throughput"]
   ],
   "format": "dec1",
   "unit": "days",
   "delta": {
    "from": [
     "div",
     ["sum","byStage.target"],
     ["sum","output.throughput"]
    ],
