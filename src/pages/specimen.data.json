  "none": { "cols": ["item", "value"], "rows": [] }
 },
 "derive": {
  "teamCalc": { "from": "teams", "add": { "load": ["div", "actual", "target"], "lo": ["mul", "target", 0.9], "hi": ["mul", "target", 1.1], "variance": ["sub", "budget", "spend"] } },
  "bins": { "from": "items", "bin": "days", "step": 3 },
  "byTeam": { "from": "items", "group": "team", "agg": { "cost": ["sum", "cost"] }, "sort": "-cost", "top": 4 },
  "late": { "from": "items", "add": { "ratio": ["div", "days", 7] }, "sort": "-days" }
 },
 "kpis": {
  "hero": { "label": "Hero tile", "value": ["last", "weeks.actual"], "unit": "units", "hero": true,
   "detail": { "value": ["div", ["last", "weeks.actual"], ["last", "weeks.plan"]], "format": "pct0", "text": "of plan" },
   "delta": { "from": ["prev", "weeks.actual"], "label": "vs last week", "good": "up" }, "spark": { "data": "weeks", "y": "actual" } },
  "flagged": { "label": "Tile with a status", "value": ["max", "teamCalc.load"], "format": "x1",
   "status": { "warning": 1.1, "critical": 1.5, "labels": { "warning": "Above band", "critical": "Far above" } } },
  "worse": { "label": "Tile with a bad change", "value": ["sum", "teams.spend"], "format": "cur0",
   "delta": { "from": ["sum", "teams.budget"], "label": "vs budget", "good": "down" } },
  "plain": { "label": "Plain tile", "value": ["count", "items"], "unit": "items" }
 },
 "cards": {
  "lineBand": { "title": "A line with a band and one marked moment", "subtitle": "Actual, units per week, against the planned range",
   "chart": { "type": "line", "data": "weeks", "x": "week", "y": "actual", "band": ["lo", "hi"], "target": "plan", "xFormat": "day", "unit": "units",
    "annotate": [{ "x": "2025-12-26", "text": "Left the band" }], "labels": { "plan": "Plan", "band": "Planned range" } } },
  "lineMulti": { "title": "Four series is the limit", "subtitle": "Units per week by region, categorical colour",
   "chart": { "type": "line", "data": "weeks", "x": "week", "y": ["north", "east", "south", "west"], "colors": "categorical", "xFormat": "day", "unit": "units" } },
  "bullet": { "title": "Bars against a target carry status by shape and colour", "subtitle": "Actual against target by team, units",
   "chart": { "type": "bar", "data": "teamCalc", "x": "team", "y": "actual", "target": "target", "band": ["lo", "hi"], "unit": "units",
    "status": { "field": "load", "warning": 1.1, "serious": 1.3, "critical": 1.5, "labels": { "warning": "Above band", "serious": "Well above", "critical": "Far above" } },
    "labels": { "band": "Target band" } } },
  "columns": { "title": "Columns for time buckets, with one highlight", "subtitle": "Actual, units per week",
   "chart": { "type": "bar", "orient": "v", "data": "weeks", "x": "week", "y": "actual", "xFormat": "day", "highlight": "max", "unit": "units" } },
  "hist": { "title": "A histogram shows the shape of a spread", "subtitle": "Items by days open, in three-day bins",
   "chart": { "type": "histogram", "data": "bins", "x": "lo", "y": "count", "xUnit": "days", "unit": "items",
    "refs": [{ "x": 9, "label": "Limit" }], "status": { "warning": 9, "critical": 15, "labels": { "warning": "Past limit", "critical": "Long past limit" } } } },
  "pareto": { "title": "A pareto names the few that matter", "subtitle": "Cost by team, dollars",
   "chart": { "type": "pareto", "data": "byTeam", "x": "team", "y": "cost", "format": "cur0" } },
  "variance": { "title": "Bars can fall below zero", "subtitle": "Budget less spend by team, dollars",
   "chart": { "type": "bar", "data": "teamCalc", "x": "team", "y": "variance", "format": "cur0" } },
  "nothing": { "title": "An empty state says so plainly", "subtitle": "A card whose table has no rows",
   "table": { "data": "none", "columns": [{ "field": "item" }, { "field": "value", "format": "int" }] } },
  "table": { "title": "A table sorts on any column and labels status in words", "subtitle": "Open items, longest first",
   "table": { "data": "late", "limit": 8, "columns": [
    { "field": "item", "label": "Item", "mono": true }, { "field": "team", "label": "Team" }, { "field": "days", "label": "Open", "format": "days0" },
    { "field": "ratio", "label": "Against limit", "format": "x1" },
    { "field": "ratio", "label": "Status", "status": { "warning": 1.3, "serious": 2, "critical": 2.5, "labels": { "warning": "Late", "serious": "Very late", "critical": "Stuck", "normal": "On time" } } },
    { "field": "cost", "label": "Cost", "format": "cur0" }] } }
 }
