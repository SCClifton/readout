        "hairline": { "$value": "{color.gray.150}" }, "border": { "$value": "{color.gray.200}" }, "border-strong": { "$value": "{color.gray.500}" },
        "text": { "$value": "{color.gray.950}" }, "text-2": { "$value": "{color.gray.700}" }, "text-3": { "$value": "{color.gray.600}" },
        "accent": { "$value": "{color.blue.650}" }, "on-accent": { "$value": "{color.gray.0}" }, "accent-text": { "$value": "{color.blue.650}" }, "accent-soft": { "$value": "{color.blue.100}" },
