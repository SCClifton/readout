{
  "$description": "Readout design tokens, the single source of truth. Three tiers: primitives (color, space, radius, font, motion, chart), semantic roles (style, data) and component tokens (density). Leaves use $value and inherit $type from their group. Aliases are written {group.path}. Generated from this file: tokens.css. Do not edit generated files.",
  "meta": { "name": { "$type": "string", "$value": "Readout" }, "version": { "$type": "string", "$value": "1.0.0" }, "prefix": { "$type": "string", "$value": "ro" } },

  "color": {
    "$type": "color",
    "gray": {
      "$description": "Cool-tinted neutrals for the soft style. OKLCH hue 258, very low chroma.",
      "0": { "$value": "#ffffff" }, "25": { "$value": "#f8fafd" }, "50": { "$value": "#f3f5f8" }, "100": { "$value": "#eef0f3" },
      "150": { "$value": "#e4e6e9" }, "200": { "$value": "#d9dbde" }, "300": { "$value": "#bbbec1" }, "400": { "$value": "#9c9fa3" },
      "450": { "$value": "#8f9297" }, "500": { "$value": "#83868b" }, "600": { "$value": "#696c71" }, "700": { "$value": "#4f5359" },
      "800": { "$value": "#31363c" }, "850": { "$value": "#252930" }, "875": { "$value": "#1f232a" }, "900": { "$value": "#191d24" },
      "925": { "$value": "#13171e" }, "950": { "$value": "#0d1219" }, "975": { "$value": "#070b12" }, "1000": { "$value": "#02040a" }
    },
    "neutral": {
      "$description": "Pure neutrals for the mono style. Same lightness steps as gray, zero chroma.",
      "0": { "$value": "#ffffff" }, "25": { "$value": "#fafafa" }, "50": { "$value": "#f5f5f5" }, "100": { "$value": "#f0f0f0" },
      "150": { "$value": "#e6e6e6" }, "200": { "$value": "#dbdbdb" }, "300": { "$value": "#bebebe" }, "400": { "$value": "#9e9e9e" },
      "450": { "$value": "#929292" }, "500": { "$value": "#868686" }, "600": { "$value": "#6c6c6c" }, "700": { "$value": "#525252" },
      "800": { "$value": "#353535" }, "850": { "$value": "#292929" }, "875": { "$value": "#232323" }, "900": { "$value": "#1d1d1d" },
      "925": { "$value": "#171717" }, "950": { "$value": "#121212" }, "975": { "$value": "#0b0b0b" }, "1000": { "$value": "#040404" }
    },
    "blue": {
      "50": { "$value": "#f0f5ff" }, "100": { "$value": "#e1ecfe" }, "200": { "$value": "#c2d9fe" }, "300": { "$value": "#99bffd" },
      "400": { "$value": "#6fa4fc" }, "500": { "$value": "#5290f6" }, "550": { "$value": "#4683e8" }, "600": { "$value": "#3570d3" },
      "650": { "$value": "#2964c6" }, "700": { "$value": "#1552b2" }, "800": { "$value": "#04409b" }, "900": { "$value": "#022d72" },
      "950": { "$value": "#082047" }
    },
