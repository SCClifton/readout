        "marking": { "$value": "{color.gray.950}" }, "on-marking": { "$value": "{color.gray.0}" }
      },
      "dark": {
        "$type": "color",
        "page": { "$value": "{color.gray.950}" }, "card": { "$value": "{color.gray.900}" }, "fill": { "$value": "{color.gray.850}" }, "raised": { "$value": "{color.gray.850}" },
        "hairline": { "$value": "{color.gray.850}" }, "border": { "$value": "{color.gray.800}" }, "border-strong": { "$value": "{color.gray.600}" },
        "text": { "$value": "{color.gray.100}" }, "text-2": { "$value": "{color.gray.300}" }, "text-3": { "$value": "{color.gray.450}" },
        "accent": { "$value": "{color.blue.600}" }, "on-accent": { "$value": "{color.gray.0}" }, "accent-text": { "$value": "{color.blue.500}" }, "accent-soft": { "$value": "{color.blue.950}" },
        "emphasis": { "$value": "{color.cat.blue.dark}" }, "neutral": { "$value": "{color.gray.600}" }, "neutral-2": { "$value": "{color.gray.700}" }, "band": { "$value": "{color.gray.800}" },
        "marking": { "$value": "{color.gray.100}" }, "on-marking": { "$value": "{color.gray.1000}" }
      }
    },
    "mono": {
      "shape": {
        "$type": "dimension",
        "radius-card": { "$value": "{radius.sm}" }, "radius-control": { "$value": "{radius.xs}" }, "radius-chip": { "$value": "{radius.xs}" }, "card-border": { "$value": "1px" }
      },
      "light": {
        "$type": "color",
        "page": { "$value": "{color.neutral.25}" }, "card": { "$value": "{color.neutral.0}" }, "fill": { "$value": "{color.neutral.100}" }, "raised": { "$value": "{color.neutral.0}" },
        "hairline": { "$value": "{color.neutral.150}" }, "border": { "$value": "{color.neutral.200}" }, "border-strong": { "$value": "{color.neutral.500}" },
        "text": { "$value": "{color.neutral.975}" }, "text-2": { "$value": "{color.neutral.700}" }, "text-3": { "$value": "{color.neutral.600}" },
        "accent": { "$value": "{color.neutral.975}" }, "on-accent": { "$value": "{color.neutral.0}" }, "accent-text": { "$value": "{color.neutral.975}" }, "accent-soft": { "$value": "{color.neutral.150}" },
        "emphasis": { "$value": "{color.neutral.975}" }, "neutral": { "$value": "{color.neutral.500}" }, "neutral-2": { "$value": "{color.neutral.300}" }, "band": { "$value": "{color.neutral.150}" },
        "marking": { "$value": "{color.neutral.975}" }, "on-marking": { "$value": "{color.neutral.0}" }
      },
      "dark": {
        "$type": "color",
        "page": { "$value": "{color.neutral.950}" }, "card": { "$value": "{color.neutral.900}" }, "fill": { "$value": "{color.neutral.850}" }, "raised": { "$value": "{color.neutral.850}" },
        "hairline": { "$value": "{color.neutral.850}" }, "border": { "$value": "{color.neutral.800}" }, "border-strong": { "$value": "{color.neutral.600}" },
        "text": { "$value": "{color.neutral.50}" }, "text-2": { "$value": "{color.neutral.300}" }, "text-3": { "$value": "{color.neutral.450}" },
        "accent": { "$value": "{color.neutral.50}" }, "on-accent": { "$value": "{color.neutral.1000}" }, "accent-text": { "$value": "{color.neutral.50}" }, "accent-soft": { "$value": "{color.neutral.800}" },
