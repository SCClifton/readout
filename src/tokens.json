      "warning": { "$value": "{color.amber.400}" }, "warning-text": { "$value": "{color.amber.700}" }, "warning-soft": { "$value": "{color.amber.100}" },
      "serious": { "$value": "{color.orange.550}" }, "serious-text": { "$value": "{color.orange.700}" }, "serious-soft": { "$value": "{color.orange.100}" },
      "critical": { "$value": "{color.red.650}" }, "critical-text": { "$value": "{color.red.700}" }, "critical-soft": { "$value": "{color.red.100}" },
      "seq-1": { "$value": "{color.blue.100}" }, "seq-2": { "$value": "{color.blue.200}" }, "seq-3": { "$value": "{color.blue.300}" }, "seq-4": { "$value": "{color.blue.400}" },
