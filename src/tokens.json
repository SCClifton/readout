  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" }, "sm": { "$value": "6px" }, "md": { "$value": "10px" }, "lg": { "$value": "14px" }, "xl": { "$value": "20px" }, "full": { "$value": "999px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale in rem at a 16px root. Names are the pixel sizes.",
      "11": { "$value": "0.6875rem" }, "12": { "$value": "0.75rem" }, "13": { "$value": "0.8125rem" }, "15": { "$value": "0.9375rem" },
      "17": { "$value": "1.0625rem" }, "20": { "$value": "1.25rem" }, "22": { "$value": "1.375rem" }, "28": { "$value": "1.75rem" },
      "34": { "$value": "2.125rem" }, "40": { "$value": "2.5rem" }, "48": { "$value": "3rem" }
