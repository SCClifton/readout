      "cat-5": { "$value": "{color.cat.gold.dark}" }, "cat-6": { "$value": "{color.cat.red.dark}" }, "cat-7": { "$value": "{color.cat.violet.dark}" }, "cat-8": { "$value": "{color.cat.green.dark}" },
