      "serious": { "$value": "{color.orange.500}" }, "serious-text": { "$value": "{color.orange.300}" }, "serious-soft": { "$value": "{color.orange.950}" },
      "critical": { "$value": "{color.red.600}" }, "critical-text": { "$value": "{color.red.300}" }, "critical-soft": { "$value": "{color.red.950}" },
      "seq-1": { "$value": "{color.blue.900}" }, "seq-2": { "$value": "{color.blue.800}" }, "seq-3": { "$value": "{color.blue.700}" }, "seq-4": { "$value": "{color.blue.600}" },
      "seq-5": { "$value": "{color.blue.500}" }, "seq-6": { "$value": "{color.blue.400}" }, "seq-7": { "$value": "{color.blue.200}" },
      "div-neg-3": { "$value": "{color.blue.300}" }, "div-neg-2": { "$value": "{color.blue.500}" }, "div-neg-1": { "$value": "{color.blue.800}" },
      "div-mid": { "$value": "{color.gray.850}" },
      "div-pos-1": { "$value": "{color.red.800}" }, "div-pos-2": { "$value": "{color.red.500}" }, "div-pos-3": { "$value": "{color.red.300}" }
    }
  },

  "density": {
    "$description": "Component tokens that change with density.",
    "comfortable": {
      "$type": "dimension",
      "gap": { "$value": "{space.5}" }, "pad-card": { "$value": "{space.5}" }, "pad-page": { "$value": "{space.8}" },
      "row": { "$value": "44px" }, "control": { "$value": "32px" }, "chart-h": { "$value": "240px" },
      "text-body": { "$value": "{font.size.15}" }, "text-label": { "$value": "{font.size.13}" }, "text-title": { "$value": "{font.size.17}" },
