    "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
    "leading": { "$type": "number", "tight": { "$value": 1.1 }, "snug": { "$value": 1.25 }, "normal": { "$value": 1.45 } },
    "tracking": { "$type": "dimension", "display": { "$value": "-0.022em" }, "title": { "$value": "-0.012em" }, "body": { "$value": "0em" }, "caps": { "$value": "0.06em" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "shadow": {
    "$description": "One elevation level, for popovers and tooltips only. Cards and data carry no shadow.",
    "pop": {
      "light": { "$type": "shadow", "$value": "0 8px 28px rgb(0 0 0 / 0.14), 0 1px 3px rgb(0 0 0 / 0.08)" },
      "dark": { "$type": "shadow", "$value": "0 8px 28px rgb(0 0 0 / 0.5), 0 1px 3px rgb(0 0 0 / 0.4)" }
    }
  },
  "chart": {
    "$type": "dimension",
    "$description": "Mark specifications. Fixed across every chart.",
    "line": { "$value": "2px" }, "grid": { "$value": "1px" }, "bar-max": { "$value": "24px" }, "bar-radius": { "$value": "4px" },
    "marker": { "$value": "8px" }, "ring": { "$value": "2px" }, "gap": { "$value": "2px" }
