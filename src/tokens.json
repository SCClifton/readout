      "400": { "$value": "#1ac18b" }, "500": { "$value": "#16ac7b" }, "550": { "$value": "#149e71" }, "600": { "$value": "#108962" },
      "650": { "$value": "#0d7c58" }, "700": { "$value": "#096849" }, "800": { "$value": "#06553b" }, "900": { "$value": "#033d2a" },
      "950": { "$value": "#01291b" }
    },
    "amber": {
      "50": { "$value": "#fff4e3" }, "100": { "$value": "#fee8c6" }, "200": { "$value": "#fdcf87" }, "300": { "$value": "#f3b02e" },
      "400": { "$value": "#d69716" }, "500": { "$value": "#be8612" }, "550": { "$value": "#af7b10" }, "600": { "$value": "#986b0c" },
      "650": { "$value": "#8a600a" }, "700": { "$value": "#745007" }, "800": { "$value": "#5f4104" }, "900": { "$value": "#452e02" },
      "950": { "$value": "#2f1e01" }
    },
    "orange": {
      "50": { "$value": "#fff2ec" }, "100": { "$value": "#fee5d8" }, "200": { "$value": "#fecbaf" }, "300": { "$value": "#fda573" },
      "400": { "$value": "#fa7c20" }, "500": { "$value": "#e16c12" }, "550": { "$value": "#cf630f" }, "600": { "$value": "#b4560c" },
      "650": { "$value": "#a34d0a" }, "700": { "$value": "#8a4007" }, "800": { "$value": "#723304" }, "900": { "$value": "#532302" },
      "950": { "$value": "#391601" }
    },
    "red": {
      "50": { "$value": "#fff2f0" }, "100": { "$value": "#fee4e1" }, "200": { "$value": "#fec9c3" }, "300": { "$value": "#fda19a" },
      "400": { "$value": "#fd746d" }, "500": { "$value": "#f05653" }, "550": { "$value": "#e24947" }, "600": { "$value": "#cc3336" },
      "650": { "$value": "#be222a" }, "700": { "$value": "#a60b1c" }, "800": { "$value": "#890715" }, "900": { "$value": "#64040c" },
      "950": { "$value": "#440609" }
    },
    "cat": {
      "$description": "Categorical hues in their fixed slot order. The order is what keeps neighbours apart for colour-blind readers, so it never changes.",
      "blue":   { "light": { "$value": "{color.blue.650}" }, "dark": { "$value": "{color.blue.550}" } },
      "orange": { "light": { "$value": "#cd7111" }, "dark": { "$value": "#d67612" } },
      "teal":   { "light": { "$value": "#118e7a" }, "dark": { "$value": "#118e7a" } },
      "pink":   { "light": { "$value": "#d464ae" }, "dark": { "$value": "#d464ae" } },
      "gold":   { "light": { "$value": "#ad9012" }, "dark": { "$value": "#ad9012" } },
